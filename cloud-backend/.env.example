# Copy to .env on the server. Never commit the real .env file.
GEMINI_API_KEY=put_your_server_side_key_here
GEMINI_MODEL=gemini-3.8-flash
# Generate a long random token for local smoke tests only.
# Replace this prototype token check with verified per-user authentication before public launch.
RYZON_BACKEND_TOKEN=replace_with_a_long_random_secret_at_least_32_characters
PORT=8080
